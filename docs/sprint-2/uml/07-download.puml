@startuml
title Beatstore — защищённое скачивание файла или лицензии
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam maxMessageSize 240
hide footbox
autonumber
actor "Покупатель" as Buyer
participant "Веб-интерфейс" as UI
participant "Сервер приложения" as API
database PostgreSQL as DB
collections "Защищённое\nхранилище" as FS
Buyer -> UI : Запросить свой файл или готовый PDF
UI -> API : Получить ссылку\n[сеанс, id заказа, id файла]
API -> DB : Проверить владельца, оплату\nи принадлежность файла заказу
DB --> API : Разрешение или причина отказа
alt Нет права доступа или PDF не готов
  API --> UI : Отказ либо состояние подготовки PDF
  UI --> Buyer : Сообщение без ссылки на файл
else Доступ разрешён
  API -> API : Создать временную ссылку\n[владелец, заказ, файл, срок до 10 минут]
  API --> UI : Ссылка на серверный маршрут скачивания
  UI --> Buyer : Предложить скачать
  Buyer -> API : Открыть ссылку со своим сеансом
  API -> API : Проверить подлинность ссылки,\nсрок и совпадение владельца
  API -> DB : Повторно проверить право на конкретный файл
  DB --> API : Результат проверки
  alt Все проверки пройдены
    API -> FS : Прочитать сохранённую версию файла
    FS --> API : Содержимое либо ошибка чтения
    API --> Buyer : Файл либо обработанная ошибка
  else Ссылка истекла, подменена или пользователь чужой
    API --> Buyer : Отказать в скачивании
  end
end
note over API,FS
  Прямой публичный путь к файлу не выдаётся.
  Публикация товара не влияет на прошлую покупку.
  Архив проекта и архив дорожек — разные файлы.
end note
@enduml
