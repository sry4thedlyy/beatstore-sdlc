@startuml
title Beatstore — создание и публикация товара
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam maxMessageSize 240
hide footbox
autonumber
actor "Администратор" as Admin
participant "Административная\nпанель" as UI
participant "Сервер приложения" as API
database PostgreSQL as DB
collections "Файловое\nхранилище" as FS
Admin -> UI : Указать данные товара, варианты и файлы
UI -> API : Создать товар\n[сеанс администратора, данные, файлы]
API -> API : Проверить роль, поля,\nтипы и размеры файлов
alt Нет прав или данные ошибочны
  API --> UI : Отказ либо ошибки полей
else Данные допустимы
  API -> FS : Сохранить обложку и демо публично,\nосновные файлы — в защищённый каталог
  alt Ошибка сохранения
    FS --> API : Ошибка
    API --> UI : Товар не опубликован; причина ошибки
  else Файлы сохранены
    FS --> API : Ключи файлов
    API -> DB : Создать черновик, варианты, цены\nи связи с версиями файлов
    DB --> API : Товар создан
    API --> UI : Черновик доступен для проверки
    Admin -> UI : Опубликовать
    UI -> API : Запрос публикации
    API -> DB : Проверить обязательные данные,\nвсе варианты, комплекты и шаблоны
    alt Комплект неполный
      API --> UI : Отказ в публикации, перечень ошибок
    else Товар готов
      API -> DB : Опубликовать товар
      API --> UI : Товар доступен в каталоге
    end
  end
end
note over API,DB
  Для бита: MP3, WAV, ZIP дорожек, ZIP проекта.
  Для драмкита: один архив и шаблон лицензии.
  При изменении создаются новые версии файлов.
  Связанные с ожидающими и оплаченными заказами
  версии не удаляются и не заменяются.
  При наличии заказов удаление заменяется архивированием.
end note
@enduml
